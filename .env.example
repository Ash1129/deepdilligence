# Copy this file to .env and fill in your own keys.

# No LLM API key is needed: LLM calls run through the Claude Code CLI.
# Install it and run `claude` once to log in.
# Optional: DD_AGENT_MODEL, DD_SYNTHESIS_MODEL, CLAUDE_CLI_PATH, DD_USE_CACHE=1
NEWS_API_KEY=your-newsapi-key

# SEC requires a descriptive User-Agent with contact information.
# Example: DeepDiligence ashwin@example.com
SEC_EDGAR_USER_AGENT=DeepDiligence your-email@example.com
